# JWT Secret key for signing and verifying tokens (generate a secure random 32+ char string in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_32chars

# JWT token expiration window in hours (default: 12)
JWT_EXPIRE_HOURS=12

# Database connection URL (default: local SQLite database)
DATABASE_URL=sqlite:///app.db

# Allowed CORS origins (comma-separated list for frontend dev and production origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Default Station Operator demo password (seeded on startup if users table is empty)
DEMO_OPERATOR_PASSWORD=operatorpassword123

# Default Station Viewer demo password (seeded on startup if users table is empty)
DEMO_VIEWER_PASSWORD=viewerpassword123
